{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "optimize:images": "node scripts/optimize-images.js",
    "optimize:video": "bash scripts/optimize-video.sh",
    "generate:sitemap": "node scripts/generate-sitemap.js",
    "prerender": "vite build --ssr src/entry-server.jsx --outDir dist-ssr && node scripts/prerender.js",
    "build": "node scripts/generate-sitemap.js && vite build && vite build --ssr src/entry-server.jsx --outDir dist-ssr && node scripts/prerender.js",
    "analyze": "ANALYZE=true vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist dist-ssr server.js",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@emailjs/browser": "^5.0.3",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@google/genai": "^2.4.0",
    "@hookform/resolvers": "^7.0.6",
    "@radix-ui/react-accordion": "^1.3.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@tailwindcss/vite": "^4.3.3",
    "@vis.gl/react-google-maps": "^1.10.2",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "framer-motion": "^14.14.0",
    "gsap": "^3.15.1",
    "lenis": "^1.3.27",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-helmet-async": "^3.1.0",
    "react-hook-form": "^7.92.0",
    "react-router-dom": "6.28.0",
    "rollup-plugin-visualizer": "^7.1.3",
    "sharp": "^0.35.5",
    "svgo": "^4.1.0",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^2.0.0",
    "web-vitals": "^6.2.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "@types/express": "^4.17.21"
  }
}
